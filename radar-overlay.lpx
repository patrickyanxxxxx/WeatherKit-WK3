# EXPERIMENTAL radar echo only — not calibrated rain intensity.
# Keep original v3.3.6 enabled; disable all earlier artificial map tests.
#!name=WK3 Experimental Radar Overlay LOCAL
[Argument]
endpoint = input,"http://127.0.0.1:8768/v1/radar",tag=Experimental radar gateway,desc=User supplied full /v1/radar endpoint
[Rule]
AND,((DOMAIN,weather-map2.apple.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
[Script]
http-request ^https://weather-map2\.apple\.com/v1/mapOverlay/precipitationRadarMap\? script-path=https://raw.githubusercontent.com/patrickyanxxxxx/WeatherKit-WK3/test/rainviewer-native/radar-loon.js?v=echo-1, timeout=10, binary-body-mode=1, tag=WK3.Experimental.Radar, argument=endpoint={endpoint}
[MITM]
hostname = weather-map2.apple.com
