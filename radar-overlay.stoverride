# EXPERIMENTAL radar echo only — not calibrated rain intensity.
# Keep original v3.3.6 enabled; disable all earlier artificial map tests.
name: WK3 Experimental Radar Overlay LOCAL
desc: Radar only; keep v3.3.6 enabled; edit endpoint JSON below
rules:
  - 'AND,((DOMAIN,weather-map2.apple.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT'
http:
  mitm:
    - weather-map2.apple.com
  script:
    - match: '^https://weather-map2\.apple\.com/v1/mapOverlay/precipitationRadarMap\?'
      name: WK3.Experimental.Radar
      type: request
      timeout: 10
      binary-mode: true
      argument: '{"endpoint":"http://127.0.0.1:8768/v1/radar"}'
script-providers:
  WK3.Experimental.Radar:
    url: https://raw.githubusercontent.com/patrickyanxxxxx/WeatherKit-WK3/test/rainviewer-native/radar-stash.js?v=echo-1
    interval: 86400
